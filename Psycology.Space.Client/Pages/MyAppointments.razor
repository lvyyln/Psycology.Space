@page "/my-appointments"
@rendermode InteractiveAuto
@attribute [Authorize(Roles = "Client")]
@inject HttpClient Http

<h1>My Appointments</h1>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (appointments is null || appointments.Count == 0)
{
    <p>You have no appointments yet. <a href="/book">Book one now!</a></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date &amp; Time</th>
                <th>Duration</th>
                <th>Notes</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var appt in appointments)
            {
                <tr>
                    <td>@appt.Slot.StartsAt.ToLocalTime().ToString("ddd, MMM d yyyy HH:mm")</td>
                    <td>@appt.Slot.DurationMinutes min</td>
                    <td>@(appt.Notes ?? "-")</td>
                    <td>
                        <span class="badge @GetStatusBadge(appt.Status)">@appt.Status</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<AppointmentDto>? appointments;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            appointments = await Http.GetFromJsonAsync<List<AppointmentDto>>("/api/appointments");
        }
        catch
        {
            appointments = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetStatusBadge(AppointmentStatus status) => status switch
    {
        AppointmentStatus.Accepted => "bg-success",
        AppointmentStatus.Declined => "bg-danger",
        _ => "bg-warning text-dark"
    };

    private enum AppointmentStatus { Pending, Accepted, Declined }
    private record SlotDto(int Id, DateTime StartsAt, int DurationMinutes);
    private record AppointmentDto(int Id, SlotDto Slot, string ClientName, AppointmentStatus Status, string? Notes);
}
