@page "/book"
@rendermode @(new InteractiveAutoRenderMode(prerender: false))
@attribute [Authorize(Roles = "Client")]
@inject HttpClient Http
@inject NavigationManager Navigation

<h1>Book an Appointment</h1>

@if (isLoading)
{
    <p>Loading available slots...</p>
}
else if (slots is null || slots.Count == 0)
{
    <p>No available slots at the moment. Please check back later.</p>
}
else
{
    @if (successMessage is not null)
    {
        <div class="alert alert-success">@successMessage</div>
    }
    @if (errorMessage is not null)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="row g-3">
        @foreach (var slot in slots)
        {
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@slot.StartsAt.ToLocalTime().ToString("dddd, MMM d")</h5>
                        <p class="card-text">
                            @slot.StartsAt.ToLocalTime().ToString("HH:mm") — @slot.StartsAt.ToLocalTime().AddMinutes(slot.DurationMinutes).ToString("HH:mm")
                            (@slot.DurationMinutes min)
                        </p>
                        @if (selectedSlotId == slot.Id)
                        {
                            <div class="mb-2">
                                <label class="form-label">Notes (optional)</label>
                                <textarea @bind="notes" class="form-control" rows="2"></textarea>
                            </div>
                            <button class="btn btn-success btn-sm me-2" @onclick="ConfirmBooking" disabled="@isBooking">
                                @(isBooking ? "Booking..." : "Confirm")
                            </button>
                            <button class="btn btn-secondary btn-sm" @onclick="CancelSelection">Cancel</button>
                        }
                        else
                        {
                            <button class="btn btn-primary btn-sm" @onclick="() => SelectSlot(slot.Id)">
                                Select
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<SlotDto>? slots;
    private int? selectedSlotId;
    private string? notes;
    private string? successMessage;
    private string? errorMessage;
    private bool isLoading = true;
    private bool isBooking;

    protected override async Task OnInitializedAsync()
    {
        await LoadSlots();
    }

    private async Task LoadSlots()
    {
        isLoading = true;
        try
        {
            slots = await Http.GetFromJsonAsync<List<SlotDto>>("/api/slots");
        }
        catch
        {
            errorMessage = "Failed to load slots.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelectSlot(int slotId)
    {
        selectedSlotId = slotId;
        notes = null;
        successMessage = null;
        errorMessage = null;
    }

    private void CancelSelection()
    {
        selectedSlotId = null;
        notes = null;
    }

    private async Task ConfirmBooking()
    {
        if (selectedSlotId is null) return;
        isBooking = true;
        errorMessage = null;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/appointments", new
            {
                SlotId = selectedSlotId.Value,
                Notes = notes
            });

            if (response.IsSuccessStatusCode)
            {
                successMessage = "Appointment booked successfully! Status: Pending.";
                selectedSlotId = null;
                notes = null;
                await LoadSlots();
            }
            else
            {
                var msg = await response.Content.ReadAsStringAsync();
                errorMessage = $"Booking failed: {msg}";
            }
        }
        catch
        {
            errorMessage = "An error occurred while booking.";
        }
        finally
        {
            isBooking = false;
        }
    }

    private record SlotDto(int Id, DateTime StartsAt, int DurationMinutes);
}
