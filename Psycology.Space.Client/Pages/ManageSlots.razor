@page "/manage-slots"
@rendermode InteractiveAuto
@attribute [Authorize(Roles = "Psychologist")]
@inject HttpClient Http

<h1>Manage Slots</h1>

<div class="row mb-4">
    <div class="col-md-4">
        <h4>Add New Slot</h4>
        @if (addError is not null)
        {
            <div class="alert alert-danger">@addError</div>
        }
        @if (addSuccess)
        {
            <div class="alert alert-success">Slot added!</div>
        }
        <div class="mb-3">
            <label class="form-label">Date &amp; Time</label>
            <input type="datetime-local" class="form-control" @bind="newSlotDate"/>
        </div>
        <div class="mb-3">
            <label class="form-label">Duration (minutes)</label>
            <input type="number" class="form-control" @bind="newSlotDuration" min="15" max="240" step="15"/>
        </div>
        <button class="btn btn-primary" @onclick="AddSlot" disabled="@isAdding">
            @(isAdding ? "Adding..." : "Add Slot")
        </button>
    </div>
</div>

<h4>All Slots</h4>
@if (isLoading)
{
    <p>Loading...</p>
}
else if (slots is null || slots.Count == 0)
{
    <p>No slots defined yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date &amp; Time</th>
                <th>Duration</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var slot in slots)
            {
                <tr>
                    <td>@slot.StartsAt.ToLocalTime().ToString("ddd, MMM d yyyy HH:mm")</td>
                    <td>@slot.DurationMinutes min</td>
                    <td><span class="badge bg-success">Available</span></td>
                    <td>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteSlot(slot.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<SlotDto>? slots;
    private DateTime newSlotDate = DateTime.Now.Date.AddHours(9);
    private int newSlotDuration = 60;
    private bool isLoading = true;
    private bool isAdding;
    private bool addSuccess;
    private string? addError;

    protected override async Task OnInitializedAsync()
    {
        await LoadSlots();
    }

    private async Task LoadSlots()
    {
        isLoading = true;
        try
        {
            slots = await Http.GetFromJsonAsync<List<SlotDto>>("/api/slots");
        }
        catch
        {
            slots = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddSlot()
    {
        isAdding = true;
        addError = null;
        addSuccess = false;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/slots", new
            {
                StartsAt = newSlotDate.ToUniversalTime(),
                DurationMinutes = newSlotDuration
            });

            if (response.IsSuccessStatusCode)
            {
                addSuccess = true;
                await LoadSlots();
            }
            else
            {
                addError = "Failed to add slot.";
            }
        }
        catch
        {
            addError = "An error occurred.";
        }
        finally
        {
            isAdding = false;
        }
    }

    private async Task DeleteSlot(int id)
    {
        var response = await Http.DeleteAsync($"/api/slots/{id}");
        if (response.IsSuccessStatusCode)
            await LoadSlots();
    }

    private record SlotDto(int Id, DateTime StartsAt, int DurationMinutes);
}
